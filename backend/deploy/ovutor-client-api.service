[Unit]
Description=Ovutor Client API
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ovutor/client-api
ExecStart=/usr/bin/dotnet /var/www/ovutor/client-api/Ovutor.Client.Api.dll
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStartSec=300
SyslogIdentifier=ovutor-client-api
StandardOutput=journal
StandardError=journal

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
EnvironmentFile=/etc/ovutor/client-api.env

[Install]
WantedBy=multi-user.target
