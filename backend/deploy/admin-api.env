# Copy to /etc/ovutor/admin-api.env on the droplet (chmod 600, root-owned — this is
# systemd's EnvironmentFile, plain KEY=VALUE, no quotes, no `export`).
# Keys use ASP.NET Core's double-underscore convention for nested config
# (Cors:AllowedOrigins:0 -> Cors__AllowedOrigins__0), same as appsettings.json.

# --- Database / cache (Postgres/Redis installed natively — see install.sh) ---
ConnectionStrings__Ovutor=Host=localhost;Port=5432;Database=Ovutor;Username=ovutor;Password=postgres
ConnectionStrings__Redis=localhost:6379

# --- JWT signing key ---------------------------------------------------------
# Generate with: openssl rand -base64 48
# Must differ from the Client API's signing key and must not start with
# "dev-only-signing-key" — the app refuses to boot in Production otherwise.
Jwt__SigningKey=H/emdMtHbQkv2LrslwmljApwgnGwWxTEId6FALMEc95bfGTWKtBpx6lF0VX9cPyA

# --- CORS (must be the exact origin your admin-portal frontend is served from) ---
Cors__AllowedOrigins__0=https://admin.ovutor.com

# --- Admin portal URL (used to build the link in "forgot password" reset tokens) ---
Frontend__AdminPortalUrl=https://admin.ovutor.com

# --- DigitalOcean Spaces (document uploads, website images) -------------------
# BucketName can be a bucket shared with other projects — RootFolder keeps this
# project's objects under their own top-level folder (e.g. "ovutor/documents/...")
# so nothing collides with whatever else lives in the same bucket. Leave
# RootFolder blank if this bucket is dedicated to Ovutor only. ForcePathStyle must
# be false for real DigitalOcean Spaces (only MinIO in local dev needs it true).
Storage__AccessKey=DO00NERK86E7JJYLPGJ9
Storage__SecretKey=Z1ohD8WrhGVI3FlLQfBD4e2iwR0BNgomhPJgpTxcEOE
Storage__BucketName=ovutor
Storage__Region=fra1
Storage__Endpoint=https://fra1.digitaloceanspaces.com
Storage__CdnEndpoint=https://ovutor.fra1.cdn.digitaloceanspaces.com
Storage__ForcePathStyle=false
Storage__RootFolder=documents


# --- Bootstrap admin accounts --------------------------------------------------
# There's no public registration endpoint, so the first admin(s) have to come from
# here. Seeded once each on startup — only creates accounts that don't already
# exist by email, never resets an existing admin's password, so it's safe to leave
# these in place indefinitely. Add as many AdminBootstrap__Admins__<N>__* groups as
# you need (at least 2 recommended, so no single person is a bottleneck to access).
AdminBootstrap__Admins__0__Name=
AdminBootstrap__Admins__0__Email=
AdminBootstrap__Admins__0__Password=
AdminBootstrap__Admins__0__Role=Lead Planner

AdminBootstrap__Admins__1__Name=
AdminBootstrap__Admins__1__Email=
AdminBootstrap__Admins__1__Password=
AdminBootstrap__Admins__1__Role=Lead Planner