[Unit]
Description=Ovutor Admin API
After=network.target postgresql.service redis-server.service ovutor-client-api.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ovutor/admin-api
ExecStart=/usr/bin/dotnet /var/www/ovutor/admin-api/Ovutor.Admin.Api.dll
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStartSec=300
SyslogIdentifier=ovutor-admin-api
StandardOutput=journal
StandardError=journal

Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5001
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
EnvironmentFile=/etc/ovutor/admin-api.env

[Install]
WantedBy=multi-user.target
