# Copy to /etc/ovutor/client-api.env on the droplet (chmod 600, root-owned — this is
# systemd's EnvironmentFile, plain KEY=VALUE, no quotes, no `export`).
# Keys use ASP.NET Core's double-underscore convention for nested config
# (Cors:AllowedOrigins:0 -> Cors__AllowedOrigins__0), same as appsettings.json.

# --- Database (Postgres installed natively — see install.sh) ------------------
ConnectionStrings__Ovutor=Host=localhost;Port=5432;Database=Ovutor;Username=ovutor;Password=REPLACE_WITH_THE_PASSWORD_YOU_SET_IN_INSTALL_SH

# --- JWT signing key ---------------------------------------------------------
# Generate with: openssl rand -base64 48
# Must differ from the Admin API's signing key and must not start with
# "dev-only-signing-key" — the app refuses to boot in Production otherwise.
Jwt__SigningKey=

# --- CORS — both the client-portal AND the wedding-website call this API ------
# (client-portal for the couple's own "/api/me/*" views, wedding-website for the
# public "/api/public/sites/*" endpoints guests hit). Add both real origins.
Cors__AllowedOrigins__0=https://client.ovutor.com
Cors__AllowedOrigins__1=https://ovutor.com

# --- Wedding website base URL (used to build each couple's public site link) --
Frontend__WeddingWebsiteUrl=https://ovutor.com

# --- DigitalOcean Spaces (reading document/image URLs shared by Admin API) ----
# Must point at the SAME bucket/region/root-folder as admin-api.env — this API only
# reads back public URLs for files the Admin API uploaded, it never writes here.
Storage__AccessKey=
Storage__SecretKey=
Storage__BucketName=ovutor-media
Storage__Region=fra1
Storage__Endpoint=https://fra1.digitaloceanspaces.com
Storage__CdnEndpoint=
Storage__ForcePathStyle=false
Storage__RootFolder=ovutor
