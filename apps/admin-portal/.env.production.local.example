# Copy to .env.production.local (gitignored — see the root .gitignore's `*.local`
# rule) inside the droplet's checkout at /opt/ovutor-src/apps/admin-portal/. Vite
# loads this automatically on `vite build` (via deploy.sh's `pnpm --filter
# @ovutor/admin-portal build`); it's baked into the built JS, not read at runtime.
# install.sh creates this file from this template on first provisioning if it
# doesn't already exist — after that, `git pull` never touches it again.

VITE_API_BASE_URL=https://admin-api.ovutor.com
VITE_WEDDING_WEBSITE_URL=https://ovutor.com
