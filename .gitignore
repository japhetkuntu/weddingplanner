node_modules
dist
.turbo
*.local
.DS_Store

# .NET build output — regenerated by every `dotnet build`/`dotnet restore` (including
# the one deploy.sh's `dotnet publish` triggers on the droplet), so a tracked copy
# only ever causes it to look "locally modified" and blocks the next `git pull`.
bin/
obj/

# Real secrets — never committed, only the *.env.example templates are tracked.
# `!*.env.example` must come after the broader rules below or git ignores it too.
.env
*.env
!*.env.example
